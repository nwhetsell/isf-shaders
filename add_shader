#!/usr/bin/env python3

import argparse
from bisect import bisect
from lxml import etree
import marko
from pathlib import Path
import subprocess
from textwrap import dedent
import urllib.parse


parser = argparse.ArgumentParser()
parser.add_argument('name', type=str, help='shader name')
parser.add_argument('--author', default='', type=str, help='original author')
parser.add_argument('--author-url', default='', type=str, help='original author webpage')
parser.add_argument('--description', default='', type=str, help='brief description')
parser.add_argument('--converted-from', default='', type=str, help='original URL')
args = parser.parse_args()

filename = f'{args.name}.glsl'

if not Path(filename).exists():
    with open(filename, 'w') as f:
        f.write(dedent(f'''\
            /*{{
                "CATEGORIES": [
                    "Filter",
                    "Generator"
                ],
                "CREDIT": "{args.author} <{args.author_url}>",
                "DESCRIPTION": "{args.description}, converted from <{args.converted_from}>",
                "INPUTS": [
                    {{
                        "NAME": "inputImage",
                        "TYPE": "image"
                    }}
                ],
                "ISFVSN": "2"
            }}*/

            #define fragColor gl_FragColor
            #define fragCoord gl_FragCoord.xy
            #define iDate DATE
            #define iFrame FRAMEINDEX
            #define iResolution RENDERSIZE
            #define iTime TIME
            #define iTimeDelta TIMEDELTA

            void main()
            {{

            }}
        '''))

md = marko.Markdown()

with open('README.md', 'r') as f:
    doc = md.parse(f.read())

md_table = doc.children[-1]
assert isinstance(md_table, marko.block.HTMLBlock)
html_table = etree.fromstring(md.render(md_table))
new_element = etree.fromstring(f'''\
  <tr>
    <td><a href="{urllib.parse.quote(filename)}">{args.name}</a></td>
    <td><a href="{args.author_url}">{args.author}</a></td>
    <td>n/a</td>
    <td>
      <ul>
        <li><a href="{args.converted_from}">Shadertoy</a></li>
        <li><a href="https://editor.isf.video/shaders/">ISF</a></li>
      </ul>
    </td>
    <td>
      <img width="197" alt="Screenshot of “{args.name}” shader" src="https://github.com/user-attachments/assets/"/>
    </td>
  </tr>
''')
new_element.tail = '\n  '

def sort_key(element):
    return element.find('./td/a').text.lower()

index = bisect(html_table.findall('tr'), sort_key(new_element), key=sort_key)
html_table.insert(index, new_element)

with open('README.md', 'r+') as f:
    f.seek(md_table.start_pos + 2) # It’s unclear why adding 2 is necessary.
    f.write(etree.tostring(html_table, encoding='unicode', pretty_print=True))

subprocess.run('./make_makefile', check=True)
subprocess.run('make', check=True)
